#!/bin/sh

NAME=wq9201s-wifi-bt-dkms

set -e

case "$1" in
    remove|upgrade|deconfigure)
      if [ "$(dkms status -m $NAME 2>/dev/null)" ]; then
         # no -v: remove whatever version is registered, keeps this
         # script in sync with the changelog automatically
         dkms remove -m $NAME --all
      fi
    ;;
    failed-upgrade)
    ;;
    *)
        echo "prerm called with unknown argument \`$1'" >&2
        exit 1
    ;;
esac

exit 0
