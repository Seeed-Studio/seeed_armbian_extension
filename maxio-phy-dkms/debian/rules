#!/usr/bin/make -f

VERSION := $(shell dpkg-parsechangelog -S Version | sed 's/-.*//')

%:
	dh $@ --parallel --with dkms

override_dh_install:
	dh_install dkms.conf Makefile usr/src/maxio-phy-$(VERSION)
	dh_install src/* usr/src/maxio-phy-$(VERSION)/src
	# The vendor 6.1 mdio_bus emits an OF-style MODALIAS for PHYs with a
	# device node, so the driver's mdio-id alias never matches and udev
	# cannot autoload it — load it explicitly at boot.
	dh_install modules-load/maxio-phy.conf etc/modules-load.d/

override_dh_dkms:
	dh_dkms -V $(VERSION)

override_dh_fixperms:
	dh_fixperms
	find debian/maxio-phy-dkms/usr/src -type f -exec chmod -x {} \;

override_dh_builddeb:
	dh_builddeb -- -Zxz

# Nothing to configure, build or auto-install
override_dh_auto_configure:
override_dh_auto_build:
override_dh_auto_test:
override_dh_auto_install:
override_dh_auto_clean:
