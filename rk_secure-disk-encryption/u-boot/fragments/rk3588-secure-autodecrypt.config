CONFIG_SPL_FIT_GENERATOR="arch/arm/mach-rockchip/make_fit_atf_optee.sh"
CONFIG_FIT_SIGNATURE=y
CONFIG_SPL_FIT_SIGNATURE=y
CONFIG_FIT_ENABLE_RSASSA_PSS_SUPPORT=y
CONFIG_USE_BOOTARGS=y
CONFIG_BOOTARGS="earlycon=uart8250,mmio32,0xfeb50000 console=ttyFIQ0 irqchip.gicv3_pseudo_nmi=0 root=/dev/mapper/armbian-root rw rootwait"

# Verified-boot lockdown: strip every unverified kernel-launch command so a
# verifying U-Boot cannot be steered into a plain OS by a foreign image's
# unsigned env blob (boot.scr, extlinux, PXE, android boot.img, raw `go`).
# bootm stays: with FIT_SIGNATURE the legacy image format is auto-disabled
# (include/config_fallbacks.h) and the required key in the control DTB makes
# bootm/boot_fit accept signed FITs only. booti is NOT disabled here --
# DISTRO_DEFAULTS selects CMD_BOOTI on ARM64 and would silently re-enable
# it at syncconfig; seeed-ota-rescue-default-env.patch guards do_booti in
# C for the same builds instead.
# CONFIG_CMD_BOOTZ is not set
# CONFIG_CMD_SOURCE is not set
# CONFIG_CMD_PXE is not set
# CONFIG_CMD_BOOT_ANDROID is not set
# CONFIG_CMD_GO is not set
